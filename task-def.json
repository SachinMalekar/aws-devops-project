{
  "family": "devops-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::368083581411:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "devops-container",
      "image": "368083581411.dkr.ecr.us-east-1.amazonaws.com/devops-web-app:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80
        }
      ]
    }
  ]
}